{
  "name": "@agora-bots/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@agora-bots/contracts": "workspace:*",
    "pg": "8.23.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node --check scripts/migrate.mjs",
    "lint": "eslint .",
    "migrate": "node scripts/migrate.mjs",
    "test": "vitest run test --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.15.5",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
