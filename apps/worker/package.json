{
  "name": "@agora-bots/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "start": "node --enable-source-maps dist/start.js",
    "test": "vitest run",
    "test:integration": "vitest run --passWithNoTests test/integration",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agora-bots/contracts": "workspace:*",
    "@agora-bots/domain": "workspace:*",
    "@agora-bots/providers": "workspace:*",
    "@agora-bots/db": "workspace:*",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.15.5",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
